# The public shell works without an env file. For local auth, run npm run local:setup.
# That command generates private .env.local and .env.test.local with random secrets.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
AUTH_MODE=disabled

# Local auth accepts only loopback learli_dev/learli_test and the restricted app role.
DATABASE_URL=
DATABASE_URL_DIRECT=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Search engines stay excluded until the approved public launch. Only the value
# "open", together with APP_ENV=production and an HTTPS APP_URL, lets them index
# the public pages. Leave it unset everywhere else.
# SEARCH_INDEXING=open

# Reserved for later. Local M2 never sends external email.
RESEND_API_KEY=
EMAIL_FROM=

# Staging database operator tooling uses an explicitly selected private config file.
# It does not load this file or enable hosted application auth. See
# docs/operations/staging-database.md for STAGING_DATABASE_URL (restricted runtime)
# and STAGING_DATABASE_URL_DIRECT (migration owner), target attestation and approval.
# Never give the application the migration credential or use a production target.

# Explicit hosted synthetic accounts (disabled by default). Staging only; no local
# DATABASE_URL/DIRECT fallback. Packet must be an owner-only absolute .local file.
# AUTH_MODE=hosted-synthetic
# HOSTED_AUTH_CONFIG_FILE=/REPLACE_WITH_CHECKOUT/.local/hosted-auth/packet.json
# HOSTED_INGRESS_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_32_TO_512_CHARS
# BETTER_AUTH_URL must exactly equal canonical HTTPS APP_URL. Actual trusted peer/
# overwritten-header provenance and any SDK send require separate authorization.
# PORT=REPLACE_WITH_EXPLICIT_HOSTED_LISTEN_PORT
# HOSTNAME=127.0.0.1

# Optional local synthetic app on an isolated schema-only Neon development branch.
# Keep DATABASE_URL and DATABASE_URL_DIRECT absent in this mode; runtime URL is
# read only from a checkout-owned0700/0600 private packet. Tests stay loopback.
# APP_ENV=development
# AUTH_MODE=local
# DATABASE_MODE=neon-development
# NEON_DEVELOPMENT_CONFIG_FILE=/absolute/checkout/.local/neon-activation/development-runtime.json
