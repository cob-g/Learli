# The public shell works without an env file. For local auth, run npm run local:setup.
# That command generates private .env.local and .env.test.local with random secrets.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
AUTH_MODE=disabled

# Local auth accepts only loopback learli_dev/learli_test and the restricted app role.
DATABASE_URL=
DATABASE_URL_DIRECT=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Reserved for later. Local M2 never sends external email.
RESEND_API_KEY=
EMAIL_FROM=

# Staging database operator tooling uses an explicitly selected private config file.
# It does not load this file or enable hosted application auth. See
# docs/operations/staging-database.md for STAGING_DATABASE_URL (restricted runtime)
# and STAGING_DATABASE_URL_DIRECT (migration owner), target attestation and approval.
# Never give the application the migration credential or use a production target.
