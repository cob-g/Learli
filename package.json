{
  "name": "learli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-test-env.mjs node_modules/.bin/playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config scripts/auth-schema.ts --output src/lib/db/schema/auth.ts --yes",
    "db:migrate": "tsx scripts/migrate-local.ts",
    "db:migrate:test": "tsx scripts/migrate-local.ts --test",
    "local:prepare": "node --import tsx scripts/local-workflow.ts",
    "db:seed": "tsx scripts/seed-local.ts",
    "mail:open": "node scripts/local-open.mjs mail",
    "fixtures:open": "node scripts/local-open.mjs fixtures",
    "test:integration": "node scripts/with-test-env.mjs node_modules/.bin/vitest run --config vitest.integration.config.ts",
    "local:setup": "npm run db:start && npm run db:migrate && npm run db:migrate:test && npm run db:seed",
    "test:restore": "node scripts/with-test-env.mjs node_modules/.bin/vitest run --config vitest.restore.config.ts",
    "db:restore:drill": "tsx scripts/local-backup-restore.ts drill",
    "deployment:preflight": "node --import tsx scripts/deployment-preflight.ts",
    "test:e2e:cross-browser": "node scripts/with-test-env.mjs node_modules/.bin/playwright test --config playwright.cross-browser.config.ts",
    "performance:baseline": "node scripts/with-test-env.mjs node scripts/performance-baseline.mjs",
    "staging:database": "tsx scripts/staging-database.ts",
    "start:hosted": "node --import tsx scripts/start-hosted-auth.ts",
    "delivery:drain": "node --conditions=react-server --import tsx scripts/transactional-delivery.ts",
    "neon:database": "tsx scripts/neon-database.ts",
    "test:e2e:private": "node scripts/with-test-env.mjs node_modules/.bin/playwright test --config playwright.private-workflow.config.ts",
    "private-workflow:operator": "node --import tsx scripts/private-workflow.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@neon/config": "1.8.6",
    "@neon/env": "1.5.3",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
